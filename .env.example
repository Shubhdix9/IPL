# ==============================================================================
# IPL Auction Website - Firebase & Next.js Environment Variables
# ==============================================================================

# Next.js Application Port & Base URL
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Public / Safe for Browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Firebase Local Emulator Suite
# Uncomment to route client traffic to local Firebase Emulators
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-Only / STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# Option 1: Service Account JSON fields (Recommended for Vercel / Cloud deployments)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Note: Ensure newlines in private key are escaped as \n if placed in a single line
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Full Service Account JSON as a Base64 string or raw string
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# Option 3: Local file path to serviceAccountKey.json (Development only - DO NOT commit)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
JWT_SECRET=your_fallback_internal_secret_key_minimum_32_characters
